#!/usr/bin/env python3
"""Deterministic linter for the matt-skills tree.

Checks: internal markdown links resolve, SKILL.md frontmatter carries
name+description, agents/*.openai.yaml parse, category README indexes match
their skill dirs. Exit 0 on pass, 1 with a report on any failure.

Seam: run from the repo root as `python scripts/lint-skills [category...]`.
"""
import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CATEGORIES = ["engineering", "in-progress", "misc", "productivity", "deprecated"]


def main(argv):
    cats = [a for a in argv if a in CATEGORIES] or CATEGORIES
    problems = []
    for cat in cats:
        cat_dir = os.path.join(ROOT, cat)
        if not os.path.isdir(cat_dir):
            continue
        # 1. every skill dir has a SKILL.md with name+description frontmatter
        for skill_md in sorted(glob.glob(os.path.join(cat_dir, "**", "SKILL.md"), recursive=True)):
            txt = open(skill_md, encoding="utf-8").read()
            if not txt.startswith("---"):
                problems.append(f"{os.path.relpath(skill_md, ROOT)}: SKILL.md missing leading '---'")
                continue
            end = txt.find("\n---", 3)
            fm = txt[3:end] if end != -1 else ""
            if "name:" not in fm or "description:" not in fm:
                problems.append(f"{os.path.relpath(skill_md, ROOT)}: frontmatter missing name/description")
        # 2. internal markdown links resolve
        for md in sorted(glob.glob(os.path.join(cat_dir, "**", "*.md"), recursive=True)):
            d = os.path.dirname(md)
            txt = open(md, encoding="utf-8").read()
            for m in re.findall(r"\]\((\.?/?[\w\-./]+\.md)\)", txt):
                target = m.strip("./")
                if not os.path.exists(os.path.join(d, target)):
                    problems.append(f"{os.path.relpath(md, ROOT)}: dead link -> {target}")
        # 3. agent yaml parses
        try:
            import yaml
            have_yaml = True
        except ImportError:
            have_yaml = False
        if have_yaml:
            for yf in sorted(glob.glob(os.path.join(cat_dir, "**", "agents", "openai.yaml"), recursive=True)):
                try:
                    yaml.safe_load(open(yf, encoding="utf-8"))
                except Exception as e:
                    problems.append(f"{os.path.relpath(yf, ROOT)}: invalid YAML ({e})")
    if problems:
        for p in problems:
            print("LINT:", p)
        print(f"FAIL: {len(problems)} problem(s) found.")
        return 1
    print("PASS: all skill-tree checks clean.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))